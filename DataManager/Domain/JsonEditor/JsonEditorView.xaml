<UserControl x:Class="DataManager.Domain.JsonEditor.JsonEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DataManager.Domain.JsonEditor"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">
    <UserControl.InputBindings>
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{x:Static local:JsonEditorCommands.CopyCommand}"/>
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{x:Static local:JsonEditorCommands.PasteCommand}"/>
    </UserControl.InputBindings>
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏区域 -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="6,4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasData}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Button Content="📋 复制简洁信息"
                        Command="{Binding CopySimpleSummaryCommand}"
                        Padding="8,3"
                        FontSize="12"
                        Cursor="Hand"
                        ToolTip="将当前表格数据以 Tab 分隔格式复制到剪贴板"/>
            </StackPanel>
        </Border>

        <!-- DataGrid 表格区域（有数据时显示） -->
        <DataGrid x:Name="DataGridView"
                  Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="All"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#E8E8E8"
                  VerticalGridLinesBrush="#E8E8E8"
                  AlternatingRowBackground="#FAFAFA"
                  RowHeaderWidth="50"
                  SelectionUnit="Cell"
                  ClipboardCopyMode="None"
                  BorderThickness="0"
                  FontSize="13"
                  LoadingRow="DataGridView_LoadingRow"
                  BeginningEdit="DataGridView_BeginningEdit"
                  CellEditEnding="DataGridView_CellEditEnding">
            <DataGrid.Style>
                <Style TargetType="DataGrid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasData}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Style>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="功能 1" IsEnabled="False"/>
                    <MenuItem Header="功能 2" IsEnabled="False"/>
                    <MenuItem Header="功能 3" IsEnabled="False"/>
                    <MenuItem Header="功能 4" IsEnabled="False"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderBrush" Value="#D0D0D0"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>

        <!-- 不支持结构时的提示文本 -->
        <TextBlock Grid.Row="1"
                   Text="{Binding UnsupportedMessage}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#999"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="40">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasData}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
