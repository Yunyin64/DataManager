<Window x:Class="DataManager.Domain.JsonEditor.JsonEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑 JSON 值"
        Width="520" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题信息 -->
        <TextBlock Grid.Row="0"
                   FontSize="13"
                   Margin="0,0,0,8">
            <Run Text="字段："/>
            <Run x:Name="FieldNameRun" FontWeight="SemiBold"/>
        </TextBlock>

        <!-- JSON 编辑区 -->
        <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1" CornerRadius="2">
            <TextBox x:Name="JsonTextBox"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Courier New"
                     FontSize="13"
                     TextWrapping="NoWrap"
                     BorderThickness="0"
                     Padding="6"/>
        </Border>

        <!-- 错误提示 -->
        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Foreground="#D32F2F"
                   FontSize="12"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <!-- 按钮区 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="格式化" Click="OnFormat_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="确认" Click="OnConfirm_Click" Padding="12,6" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="取消" Click="OnCancel_Click" Padding="12,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
