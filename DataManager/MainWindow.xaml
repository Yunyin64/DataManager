<Window x:Class="DataManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fileTree="clr-namespace:DataManager.Domain.FileTree"
        xmlns:jsonEditor="clr-namespace:DataManager.Domain.JsonEditor"
        xmlns:luaViewer="clr-namespace:DataManager.Domain.LuaViewer"
        mc:Ignorable="d"
        Title="DataManager" Height="800" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <DockPanel>
        <!-- 顶部工具栏 -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Band="0" BandIndex="0">
                <Button Command="{Binding OpenFolderCommand}" ToolTip="打开文件夹">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#128194;" Margin="0,0,4,0"/>
                        <TextBlock Text="打开文件夹"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding SaveCommand}" ToolTip="保存">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#128190;" Margin="0,0,4,0"/>
                        <TextBlock Text="保存"/>
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 中部左右分栏 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="LuaPanelColumn" Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧文件导航 -->
            <fileTree:FileTreeView Grid.Column="0"
                                   DataContext="{Binding FileTreeVM}"/>

            <!-- 分栏拖拽条 -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#E0E0E0"/>

            <!-- 中间列：JSON 编辑器 + 底部需求输入框 -->
            <DockPanel Grid.Column="2">
                <!-- 底部需求输入栏 -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,1,0,0"
                        Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding RequestInput, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Padding="6,4"
                                 FontSize="13">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="PlaceholderBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="输入需求..." Foreground="#999" FontSize="13" Margin="8,0,0,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="提交"
                                Command="{Binding SubmitRequestCommand}"
                                Padding="12,4"
                                Margin="6,0,0,0"/>
                    </Grid>
                </Border>

                <!-- JSON 内容视图 -->
                <jsonEditor:JsonEditorView DataContext="{Binding JsonEditorVM}"/>
            </DockPanel>

            <!-- Lua 面板分隔条（仅面板可见时显示） -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#E0E0E0"
                          Visibility="{Binding LuaViewerVM.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Lua 查阅/编辑面板 -->
            <luaViewer:LuaViewerView Grid.Column="4"
                                     DataContext="{Binding LuaViewerVM}"
                                     Visibility="{Binding LuaViewerVM.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </DockPanel>
</Window>
